# Copy to .env.prod on the VM and fill in. Never commit the real .env.prod.

# Public hostname for the backend. Needs an A record -> VM public IP.
# No domain? Use sslip.io, e.g. DOMAIN=api-203-0-113-5.sslip.io
DOMAIN=api.example.com

# Your Vercel production URL (for CORS). No trailing slash.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Postgres password (generate: openssl rand -hex 16)
DB_PASSWORD=change-me
