# Caddy gets a free TLS cert for $DOMAIN and reverse-proxies to the backend.
# Requires DNS: $DOMAIN -> the VM's public IP, and ports 80/443 open.
#
# An email is set so Caddy can fall back to ZeroSSL if Let's Encrypt is
# unavailable or rate-limited — both are free, trusted CAs.

{
	email bijay.official8@gmail.com
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000
}
